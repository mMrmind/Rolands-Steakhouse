# Roland's Steakhouse — Environment Variables Template
# Copy this file to .env and fill in your actual credentials

# Supabase (Optional for cloud PostgreSQL database)
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key

# PayMongo (Payment Gateway)
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY_TEST=sk_test_your_test_key_here
PAYMONGO_SECRET_KEY_LIVE=sk_live_your_live_key_here

# uSpeedo (SMS / Email Service)
USPEEDO_ACCESSKEY_ID=your_access_key
USPEEDO_ACCESSKEY_SECRET=your_access_secret
USPEEDO_SENDER_EMAIL=your_sender_email

# Gmail Nodemailer (Receipt Sending)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
